{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/brand/**",
              "components/commerce/**",
              "components/feedback/**",
              "components/icon/**",
              "components/layout/**",
              "components/messaging/**",
              "ui_kits/qr_landing/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Zilla Slab|Work Sans))/i]",
        "message": "Font not provided by the design system. Available: Zilla Slab, Work Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='BatchInfo'] > JSXAttribute > JSXIdentifier[name!=/^(?:batch|brewed|bestBefore|beans|rows|style|key|ref|className|style|children)$/]",
        "message": "<BatchInfo> doesn't accept that prop. Declared props: batch, brewed, bestBefore, beans, rows, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|icon|pressed|disabled|href|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, icon, pressed, disabled, href, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|accent|link)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'accent' | 'link'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:cta|md|sm)$/]",
        "message": "<Button> size must be one of 'cta' | 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChatBubble'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|from|time|ticks|style|key|ref|className|style|children)$/]",
        "message": "<ChatBubble> doesn't accept that prop. Declared props: children, from, time, ticks, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChatBubble'] > JSXAttribute[name.name='from'] > Literal[value!=/^(?:shop|customer)$/]",
        "message": "<ChatBubble> from must be one of 'shop' | 'customer'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChatBubble'] > JSXAttribute[name.name='ticks'] > Literal[value!=/^(?:sent|read)$/]",
        "message": "<ChatBubble> ticks must be one of 'sent' | 'read'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChevronRule'] > JSXAttribute > JSXIdentifier[name!=/^(?:base|on|width|count|style|key|ref|className|style|children)$/]",
        "message": "<ChevronRule> doesn't accept that prop. Declared props: base, on, width, count, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChevronRule'] > JSXAttribute[name.name='on'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<ChevronRule> on must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|strokeWidth|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, strokeWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:lockup|on|width|clearSpace|base|style|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: lockup, on, width, clearSpace, base, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='lockup'] > Literal[value!=/^(?:mark|stacked|horizontal|wordmark)$/]",
        "message": "<Logo> lockup must be one of 'mark' | 'stacked' | 'horizontal' | 'wordmark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='on'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<Logo> on must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NoteLine'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|icon|tone|style|key|ref|className|style|children)$/]",
        "message": "<NoteLine> doesn't accept that prop. Declared props: children, icon, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NoteLine'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:muted|strong|warning)$/]",
        "message": "<NoteLine> tone must be one of 'muted' | 'strong' | 'warning'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhoneScreen'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|title|subtitle|chrome|width|height|style|key|ref|className|style|children)$/]",
        "message": "<PhoneScreen> doesn't accept that prop. Declared props: children, title, subtitle, chrome, width, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhoneScreen'] > JSXAttribute[name.name='chrome'] > Literal[value!=/^(?:whatsapp|browser)$/]",
        "message": "<PhoneScreen> chrome must be one of 'whatsapp' | 'browser'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriceDisplay'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|price|was|note|layout|emphasis|style|key|ref|className|style|children)$/]",
        "message": "<PriceDisplay> doesn't accept that prop. Declared props: size, price, was, note, layout, emphasis, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriceDisplay'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:row|stack)$/]",
        "message": "<PriceDisplay> layout must be one of 'row' | 'stack'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriceDisplay'] > JSXAttribute[name.name='emphasis'] > Literal[value!=/^(?:normal|hero)$/]",
        "message": "<PriceDisplay> emphasis must be one of 'normal' | 'hero'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|blurb|sizes|tags|footer|style|key|ref|className|style|children)$/]",
        "message": "<ProductCard> doesn't accept that prop. Declared props: name, blurb, sizes, tags, footer, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='QtyStepper'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|min|max|onChange|label|key|ref|className|style|children)$/]",
        "message": "<QtyStepper> doesn't accept that prop. Declared props: value, min, max, onChange, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|children|sub|align|rule|style|key|ref|className|style|children)$/]",
        "message": "<SectionHeading> doesn't accept that prop. Declared props: eyebrow, children, sub, align, rule, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<SectionHeading> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|style|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: children, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|amber|success|warning|outline)$/]",
        "message": "<Tag> tone must be one of 'neutral' | 'amber' | 'success' | 'warning' | 'outline'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
